# Placeholder-only Phase 6 configuration. Do not place a token, account email, or real number here.
ACCESSRIDE_SMOKE_RECIPIENT_E164=<CONTROLLED_TEST_RECIPIENT_E164>
ACCESSRIDE_SMOKE_RECIPIENT_CONTROL_CONFIRMED=yes
ACCESSRIDE_SMOKE_OPERATOR_ID=<OPERATOR_ID>
# This literal records a human's one-call authorization; it is not a CALL-E credential.
ACCESSRIDE_SMOKE_CALL_AUTHORIZATION=APPROVED_FOR_ONE_CALL
ACCESSRIDE_SMOKE_OBJECTIVE=Verify accessibility availability only; do not reserve, book, dispatch, or arrange payment.
ACCESSRIDE_SMOKE_DISCLOSURE=Operational mobility verification only. No diagnosis or medical history is disclosed.
ACCESSRIDE_SMOKE_REQUIREMENTS=vehicle_availability,boarding_method,lift,ramp,wheelchair_securement,wheelchair_compatibility,power_wheelchair_compatibility,pickup_area,service_area,eta,authorization_route,payment_route
ACCESSRIDE_SMOKE_MAX_CALLS=1
ACCESSRIDE_SMOKE_MAX_DURATION_SECONDS=180
ACCESSRIDE_SMOKE_DEADLINE_SECONDS=240
ACCESSRIDE_SMOKE_MAX_POLLS=6
ACCESSRIDE_SMOKE_POLL_INTERVAL_SECONDS=10
